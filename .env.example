# Copie este arquivo para .env e troque os placeholders por valores seus.
# O .env está no .gitignore e nunca deve ser commitado.

# Variáveis lidas pela imagem oficial do PostgreSQL.
# O docker-compose.yml reaproveita as mesmas para montar as variáveis
# SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME e
# SPRING_DATASOURCE_PASSWORD que o Spring lê.
POSTGRES_DB=<nome_do_banco>
POSTGRES_USER=<usuario_do_banco>
POSTGRES_PASSWORD=<senha_forte>
